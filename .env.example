# Use a generated alphanumeric value so it can be embedded in DATABASE_URL.
POSTGRES_PASSWORD=
SESSION_SECRET=
PUBLIC_ORIGIN=http://127.0.0.1:3189
LOCAL_PORT=3189
SPEED_CAMERA_HOST=
TRAEFIK_NETWORK=root_default
TRAEFIK_CERT_RESOLVER=mytlschallenge
HIK_SYNC_ENABLED=false
HIK_ORIGIN=
HIK_APP_KEY=
HIK_APP_SECRET=
# Set kmh or mph after confirming the unit against a real camera sample.
HIK_SPEED_UNIT=
# Optional CA bundle inside the worker, for example /run/speed-camera/hikcentral-ca.pem.
HIK_CONTAINER_CA=
